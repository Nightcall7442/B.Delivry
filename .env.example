# =============================================================================
# BAZAR DELIVERY — environment template
# Copy to .env for local development. NEVER commit a real .env file.
# All values below are placeholders.
# =============================================================================

# ----------------------------------------------------------------------------- APP
NODE_ENV=development
APP_NAME=bazar-delivery
APP_ENV=local
API_PORT=4000
API_HOST=0.0.0.0
API_BASE_URL=http://localhost:4000
API_PREFIX=/api/v1
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8081,http://localhost:8082,http://localhost:8083,http://localhost:5173
DEFAULT_LOCALE=uz
SUPPORTED_LOCALES=uz,ru,en
DEFAULT_CURRENCY=UZS
DEFAULT_COUNTRY_CODE=UZ
DEFAULT_PHONE_PREFIX=+998
DEFAULT_TIMEZONE=Asia/Tashkent
LOG_LEVEL=debug

# ----------------------------------------------------------------------------- DATABASE
DATABASE_URL=postgresql://bazar:change_me@localhost:5432/bazar_delivery?schema=public
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
POSTGRES_USER=bazar
POSTGRES_PASSWORD=change_me
POSTGRES_DB=bazar_delivery
# Local cluster without Docker (pnpm --filter @bazar/api db:local) listens here; 5432 is often taken.
POSTGRES_PORT=5433

# ----------------------------------------------------------------------------- REDIS
# Leave empty to run without Redis (in-memory cache/sessions/queue; fine for one instance).
REDIS_URL=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=bazar:

# ----------------------------------------------------------------------------- AUTH
JWT_ACCESS_SECRET=replace_with_random_64_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace_with_random_64_chars
JWT_REFRESH_TTL=30d
SESSION_SECRET=replace_with_random_64_chars
PASSWORD_HASH_ROUNDS=12
OTP_TTL_SECONDS=300
OTP_LENGTH=6
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ----------------------------------------------------------------------------- STORAGE
STORAGE_PROVIDER=s3            # s3 | local (dev only)
STORAGE_BUCKET=bazar-delivery-dev
STORAGE_REGION=auto
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=replace_me
STORAGE_SECRET_KEY=replace_me
# With STORAGE_PROVIDER=local the API serves files itself: http://localhost:4000/storage
STORAGE_PUBLIC_URL=http://localhost:9000/bazar-delivery-dev

# ----------------------------------------------------------------------------- MAPS
MAPS_PROVIDER=osm              # google | yandex | 2gis | osm
GOOGLE_MAPS_API_KEY=
YANDEX_MAPS_API_KEY=
DGIS_API_KEY=
OSRM_BASE_URL=http://localhost:5000

# ----------------------------------------------------------------------------- PAYMENTS
PAYMENTS_DEFAULT_PROVIDER=cash # cash | payme | click | uzum | balance
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
PAYME_CALLBACK_URL=
# Sandbox checkout host while testing; leave empty for production checkout.paycom.uz
PAYME_CHECKOUT_URL=
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
UZUM_MERCHANT_ID=
UZUM_SECRET_KEY=

# ----------------------------------------------------------------------------- SMS
SMS_PROVIDER=eskiz             # eskiz | playmobile | console (dev)
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
PLAYMOBILE_LOGIN=
PLAYMOBILE_PASSWORD=

# ----------------------------------------------------------------------------- TELEGRAM
TELEGRAM_BOT_TOKEN=
# @username from BotFather, without the @: builds the t.me/<bot>?start= link
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_SUPPORT_CHAT_ID=

# ----------------------------------------------------------------------------- PUSH
PUSH_PROVIDER=expo             # expo | fcm
EXPO_ACCESS_TOKEN=
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# ----------------------------------------------------------------------------- EMAIL
EMAIL_PROVIDER=console         # console | smtp | resend
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@example.com

# ----------------------------------------------------------------------------- OBSERVABILITY
OTEL_ENABLED=false
OTEL_SERVICE_NAME=bazar-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
PROMETHEUS_METRICS_PATH=/metrics
JAEGER_UI_URL=http://localhost:16686
LOKI_URL=http://localhost:3100
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me

# ----------------------------------------------------------------------------- FRONTEND (public)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:4000
# Yandex Maps JS API 3.0 key for the storefront map (developer.tech.yandex.ru). Empty = static fallback map.
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
EXPO_PUBLIC_WS_URL=ws://localhost:4000
