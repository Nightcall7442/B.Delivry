// Bazar Delivery — Prisma schema
//
// Conventions applied here:
// - ids: String @id @default(uuid())
// - createdAt / updatedAt everywhere; deletedAt only where soft delete is real
// - multi-tenant: tenantId on tenant-scoped models + composite indexes
// - money: Int in minor units (tiyin) + a currency column, never Float
// - geo: Decimal(9,6) lat/lng (~11 cm precision); PostGIS via raw SQL later
// - status enums mirror packages/constants — constants is the source, this follows
//
// Deviation from the original sketch: Region/City/District/Mahalla are ONE
// self-referencing GeoPlace table with a level enum. Four identical tables buy
// nothing but four sets of joins, and delivery zones only ever need "the place
// and its ancestors".

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS (mirror @bazar/constants)
// ============================================================================

enum OrderStatus {
  PENDING
  CONFIRMED
  SEARCHING_COURIER
  COURIER_ASSIGNED
  COURIER_ARRIVED_PICKUP
  PICKING_UP
  PICKED_UP
  IN_DELIVERY
  COURIER_ARRIVED
  DELIVERED
  CANCELLED
  FAILED
  REFUNDED
}

enum DeliveryStatus {
  PENDING
  SEARCHING
  ASSIGNED
  AT_PICKUP
  PICKED_UP
  IN_TRANSIT
  AT_DROPOFF
  DELIVERED
  FAILED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  ONLINE
  BALANCE
  // B2B: pay by bank transfer within the customer's credit days.
  INVOICE
}

enum SubstitutionPolicy {
  CALL
  REPLACE
  REMOVE
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum TransactionType {
  CHARGE
  CAPTURE
  REFUND
  CANCEL
}

// What a payment is for. Orders are the rule; the rest are the platform's own products.
enum PaymentPurpose {
  ORDER
  PLUS
  TIP
  // A vendor buying a promoted spot for a store.
  PROMO
}

enum WalletTransactionType {
  ORDER_PAYOUT
  CASH_COLLECTED
  // Debit: an order or a Plus month paid from the balance.
  PAYMENT
  CASHBACK
  TIP
  REFERRAL
  TOPUP
  WITHDRAWAL
  ADJUSTMENT
  REFUND
}

enum UserStatus {
  PENDING
  ACTIVE
  BLOCKED
  DELETED
}

enum SystemRole {
  CUSTOMER
  COURIER
  VENDOR
  OPERATOR
  ADMIN
  SUPER_ADMIN
}

enum CourierStatus {
  OFFLINE
  ONLINE
  BUSY
  SUSPENDED
}

enum VehicleType {
  FOOT
  BICYCLE
  SCOOTER
  MOTORBIKE
  CAR
  VAN
}

enum StoreType {
  BAZAAR_STALL
  SHOP
  SUPERMARKET
  LOCAL_POINT
  ENTREPRENEUR
  RESTAURANT
  DARK_STORE
  WAREHOUSE
}

enum StoreStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  SUSPENDED
  CLOSED
}

enum VendorStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum VendorLegalType {
  INDIVIDUAL_ENTREPRENEUR
  LLC
  UNREGISTERED
}

enum ProductUnit {
  PCS
  KG
  G
  L
  ML
  PACK
  BOX
}

enum GeoLevel {
  REGION
  CITY
  DISTRICT
  MAHALLA
}

enum AddressLabel {
  HOME
  WORK
  OTHER
}

enum DiscountType {
  PERCENT
  FIXED
  FREE_DELIVERY
}

enum ReviewTarget {
  STORE
  PRODUCT
  COURIER
}

enum NotificationChannel {
  PUSH
  SMS
  TELEGRAM
  EMAIL
  IN_APP
}

enum NotificationStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  READ
}

enum TicketStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum TicketTopic {
  ORDER_ISSUE
  PAYMENT_ISSUE
  COURIER_ISSUE
  PRODUCT_QUALITY
  ACCOUNT
  OTHER
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ProofType {
  PHOTO
  SIGNATURE
  CODE
  NONE
}

enum OtpPurpose {
  LOGIN
  PHONE_CHANGE
  ORDER_HANDOVER
}

// ============================================================================
// TENANCY
// ============================================================================

model Tenant {
  id               String   @id @default(uuid())
  slug             String   @unique
  name             String
  domain           String?  @unique
  defaultLocale    String   @default("uz")
  supportedLocales String[] @default(["uz", "ru", "en"])
  currency         String   @default("UZS")
  timezone         String   @default("Asia/Tashkent")
  supportPhone     String?
  active           Boolean  @default(true)
  // White-label: { appName, logoUrl, primary, accent, city } — see TenantBrandingDto.
  branding         Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  settings   TenantSettings?
  users      User[]
  customers  Customer[]
  couriers   Courier[]
  vendors    Vendor[]
  stores     Store[]
  products   Product[]
  orders     Order[]
  deliveries Delivery[]
  payments   Payment[]
  auditLogs  AuditLog[]

  @@map("tenants")
}

model TenantSettings {
  tenantId String  @id
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Kill switch: stop taking orders platform-wide without a deploy.
  ordersEnabled      Boolean @default(true)
  autoConfirmOrders  Boolean @default(false)
  autoAssignCouriers Boolean @default(true)
  defaultTariffId    String?
  minAppVersion      String?
  maintenanceMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tenant_settings")
}

// ============================================================================
// IDENTITY & ACCESS
// ============================================================================

model User {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  // Canonical +998XXXXXXXXX. Login identity, unique inside a tenant.
  phone           String
  email           String?
  passwordHash    String?
  firstName       String?
  lastName        String?
  avatarUrl       String?
  locale          String     @default("uz")
  status          UserStatus @default(PENDING)
  phoneVerifiedAt DateTime?
  lastLoginAt     DateTime?
  // Failed password attempts since the last success; feeds the lockout.
  failedLogins    Int        @default(0)
  lockedUntil     DateTime?
  // Telegram bot: the chat that gets this user's order updates, and the
  // one-shot code the app hands to t.me/<bot>?start=<code> to link it.
  telegramChatId   String? @unique
  telegramLinkCode String? @unique

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  roles         UserRole[]
  sessions      Session[]
  otpCodes      OtpCode[]
  pushTokens    PushToken[]
  customer      Customer?
  courier       Courier?
  vendor        Vendor?
  notifications Notification[]
  wallet        WalletTransaction[]
  tickets       SupportTicket[]      @relation("TicketAuthor")
  assignedTickets SupportTicket[]    @relation("TicketAssignee")
  ticketMessages SupportMessage[]
  auditLogs     AuditLog[]

  @@unique([tenantId, phone])
  @@index([tenantId, status])
  @@index([tenantId, email])
  @@map("users")
}

// Roles are a fixed enum, not a table: they ship with the code, and the
// permission matrix lives in @bazar/auth so the admin UI can reuse it.
model UserRole {
  id     String     @id @default(uuid())
  userId String
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   SystemRole

  grantedAt DateTime @default(now())
  grantedBy String?

  @@unique([userId, role])
  @@index([role])
  @@map("user_roles")
}

// Per-user permission grants on top of the role matrix. Rare, but it is what
// lets one operator get refund rights without inventing a new role.
model UserPermission {
  id         String   @id @default(uuid())
  userId     String
  permission String
  grantedAt  DateTime @default(now())
  grantedBy  String?

  @@unique([userId, permission])
  @@map("user_permissions")
}

model Session {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Hash, never the token itself: a database leak must not hand out sessions.
  refreshTokenHash String
  // Bumped on every rotation; an older version replayed means the token leaked.
  version          Int      @default(0)
  deviceId         String?
  deviceName       String?
  ip               String?
  userAgent        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  lastSeenAt       DateTime @default(now())
  createdAt        DateTime @default(now())

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

model OtpCode {
  id     String  @id @default(uuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tenantId String
  phone    String
  // Hashed like a password: an OTP is a credential for its 5 minutes.
  codeHash String
  purpose  OtpPurpose @default(LOGIN)
  attempts Int        @default(0)
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([tenantId, phone, purpose])
  @@index([expiresAt])
  @@map("otp_codes")
}

model PushToken {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  token    String @unique
  platform String
  deviceId String?
  // Cleared when the provider reports the token as gone.
  invalidAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, invalidAt])
  @@map("push_tokens")
}

// ============================================================================
// ACTORS
// ============================================================================

model Customer {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  defaultAddressId String?
  orderCount       Int      @default(0)
  totalSpent       Int      @default(0)
  // Store credit from refunds and referrals, in minor units.
  balance          Int      @default(0)
  currency         String   @default("UZS")
  loyaltyPoints    Int      @default(0)
  // Bazar Plus: free delivery and priority dispatch until this moment.
  plusUntil        DateTime?
  // Referral: my code to share, and who brought me here.
  referralCode     String?  @unique
  referredById     String?
  referralRewardedAt DateTime?
  marketingOptIn   Boolean  @default(true)
  blockedAt        DateTime?
  lastOrderAt      DateTime?
  // B2B (cafés, canteens): the company on the invoice, and the credit an
  // operator granted — INVOICE orders are allowed once approved, up to the limit.
  companyName        String?
  companyInn         String?
  businessAppliedAt  DateTime?
  businessApprovedAt DateTime?
  creditDays         Int       @default(0)
  creditLimit        Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addresses Address[]
  carts     Cart[]
  orders    Order[]
  reviews   Review[]
  subscriptions CartSubscription[]

  @@index([tenantId])
  @@map("customers")
}

// "Every Saturday by 9:00": the same basket, placed by a job two hours before
// the slot. Items are a snapshot (id, name, unit, quantity) so a renamed
// product keeps its line and a removed one is simply skipped.
model CartSubscription {
  id         String   @id @default(uuid())
  tenantId   String
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  storeId    String
  addressId  String
  paymentMethod PaymentMethod
  items      Json

  // Local (Asia/Tashkent) weekday 0 = Sunday … 6 = Saturday, and the slot's start hour.
  weekday Int
  hour    Int
  active  Boolean @default(true)

  nextRunAt   DateTime
  lastRunAt   DateTime?
  lastOrderId String?
  // Set when the last run failed (store closed, nothing available); shown to the customer.
  lastError   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, active, nextRunAt])
  @@index([customerId])
  @@map("cart_subscriptions")
}

model Courier {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status      CourierStatus @default(OFFLINE)
  vehicleType VehicleType   @default(FOOT)
  plateNumber String?
  cityId      String
  city        GeoPlace      @relation(fields: [cityId], references: [id])

  rating           Float @default(0)
  ratingCount      Int   @default(0)
  completedOrders  Int   @default(0)
  cancelledOrders  Int   @default(0)
  // Cash collected on delivery that the courier still owes the platform.
  balance          Int   @default(0)
  currency         String @default("UZS")
  maxConcurrentOrders Int @default(1)

  // Denormalized last fix: the live map reads this instead of scanning the
  // location history table on every refresh.
  lastLat       Decimal? @db.Decimal(9, 6)
  lastLng       Decimal? @db.Decimal(9, 6)
  lastLocationAt DateTime?

  // Mahalla courier: a neighbour who delivers on foot near home only.
  neighbour        Boolean  @default(false)
  homeLat          Decimal? @db.Decimal(9, 6)
  homeLng          Decimal? @db.Decimal(9, 6)
  homeRadiusMeters Int?

  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  deliveries Delivery[]
  locations  CourierLocation[]
  orders     Order[]

  @@index([tenantId, status])
  @@index([cityId, status])
  @@index([lastLat, lastLng])
  @@map("couriers")
}

model Vendor {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  legalType VendorLegalType @default(UNREGISTERED)
  status    VendorStatus    @default(PENDING)
  legalName String
  displayName String
  // STIR/INN. Absent for unregistered bazaar sellers.
  taxId     String?
  phone     String
  email     String?
  bankAccount String?
  // Overrides the tariff commission when set.
  commissionPercent Float?
  verifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stores Store[]

  @@index([tenantId, status])
  @@map("vendors")
}

model Store {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id])

  type   StoreType
  status StoreStatus @default(DRAFT)
  // i18n text: { "uz": "...", "ru": "...", "en": "..." }
  name        Json
  description Json?
  slug        String
  logoUrl     String?
  coverUrl    String?
  // "Прилавок сейчас": the vendor's morning photo of the counter, dated.
  counterPhotoUrl String?
  counterPhotoAt  DateTime?
  phone       String?

  cityId String
  city   GeoPlace @relation(fields: [cityId], references: [id])
  address String?
  lat     Decimal? @db.Decimal(9, 6)
  lng     Decimal? @db.Decimal(9, 6)
  // Row/stall number at the bazaar: what the courier actually looks for.
  standNumber String?
  // The person behind the counter: name, the year they started, a photo, a line in their words.
  ownerName     String?
  ownerSince    Int?
  ownerPhotoUrl String?
  ownerMotto    Json?

  rating      Float @default(0)
  reviewCount Int   @default(0)
  // Minutes the store needs before a courier should arrive.
  preparationMinutes Int @default(15)
  // Paid placement: shown first on the home list with a «Реклама» label until then.
  promotedUntil DateTime?
  // Badges the customer sees: eco, halal, homemade… (STORE_TAG in constants).
  tags          String[] @default([])
  // A chain (Korzinka, Makro…): branches share the slug, the customer sees one shopfront
  // and the order goes to the branch nearest their address.
  chainSlug String?
  // Per-store overrides of the tariff's minimum order and free-delivery threshold (minor units).
  minOrder              Int?
  freeDeliveryThreshold Int?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  schedule StoreSchedule[]
  products Product[]
  carts    Cart[]
  orders   Order[]

  @@unique([tenantId, slug])
  @@index([tenantId, status])
  @@index([cityId, status])
  @@index([vendorId])
  @@index([tenantId, chainSlug])
  @@map("stores")
}

model StoreSchedule {
  id      String @id @default(uuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  // 0 = Sunday, matching Date.getDay().
  weekday Int
  // Minutes since local midnight, so comparisons need no date parsing.
  opensAt Int
  closesAt Int
  closed  Boolean @default(false)

  @@unique([storeId, weekday])
  @@map("store_schedules")
}

// ============================================================================
// GEO
// ============================================================================

model GeoPlace {
  id       String   @id @default(uuid())
  level    GeoLevel
  code     String
  // i18n names.
  name     Json
  parentId String?
  parent   GeoPlace?  @relation("GeoTree", fields: [parentId], references: [id])
  children GeoPlace[] @relation("GeoTree")

  centerLat Decimal? @db.Decimal(9, 6)
  centerLng Decimal? @db.Decimal(9, 6)
  active    Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  zones     DeliveryZone[]
  tariffs   Tariff[]
  stores    Store[]
  couriers  Courier[]
  addresses Address[]

  @@unique([level, code])
  @@index([parentId])
  @@map("geo_places")
}

model DeliveryZone {
  id     String   @id @default(uuid())
  name   String
  cityId String
  city   GeoPlace @relation(fields: [cityId], references: [id])

  // GeoJSON Polygon coordinates: [[[lng, lat], ...]]. Checked in application
  // code (packages/maps pointInPolygon) until PostGIS is introduced.
  polygon Json
  tariffId String
  tariff   Tariff @relation(fields: [tariffId], references: [id])
  // Higher wins where zones overlap.
  priority Int     @default(0)
  active   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cityId, active])
  @@map("delivery_zones")
}

model Tariff {
  id     String    @id @default(uuid())
  name   String
  cityId String?
  city   GeoPlace? @relation(fields: [cityId], references: [id])

  // All amounts in minor units.
  base               Int
  perKm              Int
  freeDistanceMeters Int     @default(0)
  minFee             Int
  maxFee             Int?
  commissionPercent  Float   @default(0)
  serviceFee         Int     @default(0)
  freeDeliveryThreshold Int?
  minOrder           Int     @default(0)
  currency           String  @default("UZS")
  active             Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  zones      DeliveryZone[]
  surgeRules SurgeRule[]

  @@index([cityId, active])
  @@map("tariffs")
}

model SurgeRule {
  id       String @id @default(uuid())
  tariffId String
  tariff   Tariff @relation(fields: [tariffId], references: [id], onDelete: Cascade)

  // Empty = every day. 0 = Sunday.
  weekdays   Int[]
  fromMinute Int
  toMinute   Int
  // 1.5 = +50%, applied to the delivery fee only, never to the goods.
  multiplier Float
  active     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tariffId, active])
  @@map("surge_rules")
}

model Address {
  id         String   @id @default(uuid())
  tenantId   String
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  label  AddressLabel @default(HOME)
  title  String?
  cityId String
  city   GeoPlace @relation(fields: [cityId], references: [id])
  districtId String?
  mahallaId  String?

  street    String?
  house     String?
  apartment String?
  entrance  String?
  floor     String?
  intercom  String?
  // Uzbek addressing is landmark-driven; these two matter as much as the number.
  landmark     String?
  instructions String?

  lat Decimal? @db.Decimal(9, 6)
  lng Decimal? @db.Decimal(9, 6)

  isDefault Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([customerId, deletedAt])
  @@index([tenantId, cityId])
  @@map("addresses")
}

// ============================================================================
// CATALOG
// ============================================================================

model Category {
  id       String    @id @default(uuid())
  name     Json
  slug     String    @unique
  parentId String?
  parent   Category? @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")

  // Materialized ancestor chain, so a whole subtree is one LIKE query.
  path      String
  depth     Int      @default(0)
  iconUrl   String?
  imageUrl  String?
  sortOrder Int      @default(0)
  active    Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@index([parentId, active])
  @@index([path])
  @@map("categories")
}

model Product {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  storeId  String
  store    Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  name        Json
  description Json?
  slug        String
  unit        ProductUnit @default(PCS)

  // Current price in minor units. History lives in ProductPrice.
  price    Int
  oldPrice Int?
  currency String @default("UZS")

  // Fractional for weighed goods: 0.5 kg minimum, 0.1 kg steps.
  minQuantity  Decimal @default(1) @db.Decimal(10, 3)
  quantityStep Decimal @default(1) @db.Decimal(10, 3)
  weightGrams  Int?

  available Boolean @default(true)
  // null = the seller does not track stock (typical for a bazaar stall).
  stock     Decimal? @db.Decimal(10, 3)

  rating      Float @default(0)
  reviewCount Int   @default(0)

  discountRequests DiscountRequest[]

  // "Сегодня привезли": set by the vendor in the morning; the badge lasts a day.
  arrivedAt DateTime?
  tags      String[] @default([])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  images     ProductImage[]
  priceHistory ProductPrice[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([storeId, slug])
  @@index([tenantId, available])
  @@index([storeId, available])
  @@index([categoryId, available])
  @@map("products")
}

// Price changes are appended, never overwritten: disputes about "it cost less
// yesterday" are settled from here.
model ProductPrice {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  price     Int
  currency  String   @default("UZS")
  changedBy String?
  validFrom DateTime @default(now())

  @@index([productId, validFrom])
  @@map("product_prices")
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  width     Int?
  height    Int?
  alt       String?
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())

  @@index([productId, sortOrder])
  @@map("product_images")
}

// ============================================================================
// CART
// ============================================================================

model Cart {
  id         String   @id @default(uuid())
  tenantId   String
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  // One cart per store: an order is picked up at a single stall.
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items CartItem[]

  @@unique([customerId, storeId])
  @@index([expiresAt])
  @@map("carts")
}

model CartItem {
  id        String  @id @default(uuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  quantity Decimal @db.Decimal(10, 3)
  // Price when the item was added; compared against the product on checkout.
  unitPrice Int
  currency  String  @default("UZS")
  comment   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
  @@map("cart_items")
}

// ============================================================================
// ORDERS
// ============================================================================

model Order {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  // Human-facing, e.g. BZ-240907-4KDQ8P. Read out over the phone.
  number String

  status     OrderStatus @default(PENDING)
  customerId String
  customer   Customer    @relation(fields: [customerId], references: [id])
  storeId    String
  store      Store       @relation(fields: [storeId], references: [id])
  courierId  String?
  courier    Courier?    @relation(fields: [courierId], references: [id])

  // Totals in minor units. Copied at creation and only recomputed on repricing.
  subtotal    Int
  deliveryFee Int    @default(0)
  serviceFee  Int    @default(0)
  discount    Int    @default(0)
  total       Int
  currency    String @default("UZS")

  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(PENDING)

  // Address frozen onto the order: later edits must not rewrite history.
  addressCityId       String
  addressFormatted    String
  addressStreet       String?
  addressHouse        String?
  addressApartment    String?
  addressEntrance     String?
  addressFloor        String?
  addressLandmark     String?
  addressInstructions String?
  addressLat          Decimal? @db.Decimal(9, 6)
  addressLng          Decimal? @db.Decimal(9, 6)

  comment      String?
  // What the courier does when the stall is out of something, and what the
  // customer wants the vendor to know ("помидоры покрепче").
  substitutionPolicy SubstitutionPolicy @default(CALL)
  vendorComment      String?
  cancelReason String?
  // null = as soon as possible.
  scheduledFor DateTime?
  etaAt        DateTime?
  // What the customer was told at checkout; the late-delivery promise is measured against it.
  promisedAt   DateTime?
  // The saved address the frozen copy below came from; lets a subscription reuse it.
  addressId    String?
  // Delivery fee before Plus / thresholds / coupons waived it: the courier's payout base.
  courierFee   Int       @default(0)
  // "Заказ родителям": who opens the door when it is not the customer. The
  // courier calls this number; the recipient gets one SMS when the order sets off.
  recipientName  String?
  recipientPhone String?
  // Cross-bazaar: sibling orders from stalls of one bazaar share a courier and
  // one delivery fee; the group id is the leading order's id.
  groupId      String?
  // INVOICE orders: pay by this date (placed + the customer's credit days).
  dueAt        DateTime?
  placedAt     DateTime  @default(now())
  confirmedAt  DateTime?
  deliveredAt  DateTime?
  cancelledAt  DateTime?

  couponId String?
  coupon   Coupon? @relation(fields: [couponId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  messages      ChatMessage[]
  delivery      Delivery?
  payments      Payment[]
  reviews       Review[]
  notifications Notification[]
  tickets       SupportTicket[]
  redemption    CouponRedemption?

  @@unique([tenantId, number])
  @@index([tenantId, status, placedAt])
  @@index([customerId, placedAt])
  @@index([storeId, status])
  @@index([courierId, status])
  @@index([groupId])
  @@map("orders")
}

// Demand: what people searched or dictated, and whether the catalogue had it.
// "unmet" queries tell a vendor what to bring tomorrow.
model SearchQuery {
  id         String   @id @default(uuid())
  tenantId   String
  query      String
  // Lower-cased, apostrophes stripped: the grouping key.
  normalized String
  results    Int
  // search | list (a shopping-list line the parser could not match)
  source     String
  storeId    String?
  customerId String?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, normalized])
  @@map("search_queries")
}

model OrderItem {
  id      String @id @default(uuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // Nullable: the product may be deleted later, the line must survive.
  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  // Snapshot, not a join: a catalog edit cannot rewrite what was agreed.
  name      Json
  unit      ProductUnit
  quantity  Decimal     @db.Decimal(10, 3)
  unitPrice Int
  total     Int
  currency  String      @default("UZS")
  comment   String?

  // Weighed goods: what the courier actually bought at the stall, and the
  // photo of the scale that proves it.
  actualQuantity   Decimal? @db.Decimal(10, 3)
  actualTotal      Int?
  weighingPhotoUrl String?

  createdAt DateTime @default(now())

  @@index([orderId])
  @@map("order_items")
}

enum HaggleStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

// The bazaar's oldest feature: "Попросить скидку". The vendor answers with a
// price; an accepted one is this customer's personal price until it expires.
model DiscountRequest {
  id         String       @id @default(uuid())
  tenantId   String
  customerId String
  storeId    String
  productId  String
  product    Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Per unit, minor units.
  askedPrice Int
  // The vendor's answer (accepted as asked, or a counter); null until answered.
  offeredPrice Int?
  status     HaggleStatus @default(PENDING)
  message    String?
  reply      String?
  // Unanswered: when the ask lapses; accepted: how long the price holds.
  expiresAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, storeId, status])
  @@index([customerId, productId, status])
  @@map("discount_requests")
}

// "Я у второго подъезда": the customer and the courier, in the order's own thread.
model ChatMessage {
  id           String   @id @default(uuid())
  tenantId     String
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  senderUserId String
  senderRole   String
  text         String
  createdAt    DateTime @default(now())

  @@index([orderId, createdAt])
  @@map("chat_messages")
}

// Append-only trail of every status the order passed through.
model OrderStatusHistory {
  id      String      @id @default(uuid())
  orderId String
  order   Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status  OrderStatus
  // null for system transitions (jobs, timeouts).
  actorId String?
  comment String?
  at      DateTime    @default(now())

  @@index([orderId, at])
  @@map("order_status_history")
}

// ============================================================================
// DELIVERY & TRACKING
// ============================================================================

model Delivery {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  orderId  String @unique
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  courierId String?
  courier   Courier? @relation(fields: [courierId], references: [id])
  status    DeliveryStatus @default(PENDING)

  pickupLat  Decimal? @db.Decimal(9, 6)
  pickupLng  Decimal? @db.Decimal(9, 6)
  pickupAddress String
  dropoffLat Decimal? @db.Decimal(9, 6)
  dropoffLng Decimal? @db.Decimal(9, 6)
  dropoffAddress String

  distanceMeters Int    @default(0)
  // What the courier earns for this trip, in minor units.
  payout         Int    @default(0)
  currency       String @default("UZS")

  assignedAt  DateTime?
  pickedUpAt  DateTime?
  deliveredAt DateTime?
  etaAt       DateTime?

  proofType     ProofType @default(NONE)
  proofUrl      String?
  // Code the customer reads out on handover, when proofType is CODE.
  handoverCode  String?
  failureReason String?
  attemptCount  Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offers DeliveryOffer[]

  @@index([tenantId, status])
  @@index([courierId, status])
  @@map("deliveries")
}

// One row per courier the order was offered to. Keeps a declined courier from
// being offered the same order again, and makes the search auditable.
model DeliveryOffer {
  id         String   @id @default(uuid())
  deliveryId String
  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  courierId  String

  offeredAt  DateTime  @default(now())
  expiresAt  DateTime
  acceptedAt DateTime?
  declinedAt DateTime?

  @@unique([deliveryId, courierId])
  @@index([courierId, expiresAt])
  @@map("delivery_offers")
}

// High-volume time series. Partition or move to TimescaleDB when it hurts;
// until then a plain table with a retention job is enough.
model CourierLocation {
  id        String  @id @default(uuid())
  courierId String
  courier   Courier @relation(fields: [courierId], references: [id], onDelete: Cascade)
  orderId   String?

  lat            Decimal @db.Decimal(9, 6)
  lng            Decimal @db.Decimal(9, 6)
  heading        Float?
  speedKmh       Float?
  accuracyMeters Float?

  // Device clock; pings arrive out of order and late.
  recordedAt DateTime
  createdAt  DateTime @default(now())

  @@index([courierId, recordedAt])
  @@index([orderId, recordedAt])
  @@map("courier_locations")
}

// ============================================================================
// PAYMENTS
// ============================================================================

model Payment {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  // Null for a Plus month or a tip: those belong to the customer, not to an order.
  orderId  String?
  order    Order?  @relation(fields: [orderId], references: [id])
  customerId String
  purpose  PaymentPurpose @default(ORDER)
  // The id provider callbacks carry: the order id, or "plus:<customerId>:<period>" / "tip:<orderId>:<amount>".
  subject  String

  method   PaymentMethod
  provider String
  status   PaymentStatus @default(PENDING)

  amount         Int
  refundedAmount Int    @default(0)
  currency       String @default("UZS")

  // Provider-side id, used to match incoming webhooks back to this row.
  externalId      String?
  confirmationUrl String?
  paidAt          DateTime?
  failureReason   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions PaymentTransaction[]

  @@index([tenantId, status])
  @@index([orderId])
  @@index([subject])
  @@index([externalId])
  @@map("payments")
}

model PaymentTransaction {
  id        String  @id @default(uuid())
  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  type   TransactionType
  status PaymentStatus
  amount Int
  currency String @default("UZS")
  externalId String?
  // Unique: the same key twice must never charge twice.
  idempotencyKey String @unique
  raw    Json?

  createdAt DateTime @default(now())

  @@index([paymentId, createdAt])
  @@map("payment_transactions")
}

// Courier and customer balances are a ledger: the balance is the sum of rows,
// and balanceAfter is stored so a statement can be printed without a window fn.
model WalletTransaction {
  id       String @id @default(uuid())
  tenantId String
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type         WalletTransactionType
  amount       Int
  balanceAfter Int
  currency     String @default("UZS")
  orderId      String?
  comment      String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([tenantId, type])
  @@map("wallet_transactions")
}

// ============================================================================
// PROMOTIONS
// ============================================================================

model Promotion {
  id       String @id @default(uuid())
  tenantId String

  name        Json
  description Json?
  discountType DiscountType
  // Percent for PERCENT, minor units for FIXED, ignored for FREE_DELIVERY.
  value        Float
  maxDiscount  Int?
  minOrder     Int?
  currency     String @default("UZS")

  storeIds    String[]
  categoryIds String[]
  cityIds     String[]

  startsAt DateTime
  endsAt   DateTime?
  active   Boolean   @default(true)
  bannerUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  coupons Coupon[]

  @@index([tenantId, active, startsAt])
  @@map("promotions")
}

model Coupon {
  id          String    @id @default(uuid())
  tenantId    String
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  code String
  // null = unlimited.
  maxRedemptions Int?
  maxPerCustomer Int  @default(1)
  redemptionCount Int @default(0)
  // Set for personal coupons issued as compensation.
  customerId String?
  expiresAt  DateTime?
  active     Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  redemptions CouponRedemption[]
  orders      Order[]

  @@unique([tenantId, code])
  @@index([promotionId])
  @@map("coupons")
}

// One row per use. The unique on orderId is what makes redemption idempotent.
model CouponRedemption {
  id         String @id @default(uuid())
  couponId   String
  coupon     Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  customerId String
  orderId    String @unique
  order      Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  discount   Int

  createdAt DateTime @default(now())

  @@index([couponId, customerId])
  @@map("coupon_redemptions")
}

// ============================================================================
// FEEDBACK, NOTIFICATIONS, SUPPORT
// ============================================================================

model Review {
  id         String   @id @default(uuid())
  tenantId   String
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  target   ReviewTarget
  targetId String
  rating   Int
  comment  String?
  photoUrls String[]

  reply     String?
  repliedAt DateTime?
  published Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One review per target per order: no rating the same courier five times.
  @@unique([orderId, target, targetId])
  @@index([target, targetId, published])
  @@map("reviews")
}

model Notification {
  id       String @id @default(uuid())
  tenantId String
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  channel  NotificationChannel
  status   NotificationStatus  @default(QUEUED)
  template String
  title    String
  body     String
  deepLink String?
  orderId  String?
  order    Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  // Same key twice = one notification, even across job retries.
  idempotencyKey String? @unique
  externalId     String?
  failureReason  String?
  sentAt         DateTime?
  readAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, readAt])
  @@index([tenantId, status])
  @@map("notifications")
}

model NotificationPreference {
  userId    String  @id
  push      Boolean @default(true)
  sms       Boolean @default(true)
  telegram  Boolean @default(true)
  email     Boolean @default(false)
  marketing Boolean @default(true)

  updatedAt DateTime @updatedAt

  @@map("notification_preferences")
}

model SupportTicket {
  id       String @id @default(uuid())
  tenantId String
  number   String
  userId   String
  user     User   @relation("TicketAuthor", fields: [userId], references: [id], onDelete: Cascade)
  orderId  String?
  order    Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  topic    TicketTopic
  status   TicketStatus   @default(OPEN)
  priority TicketPriority @default(NORMAL)
  subject  String

  assigneeId String?
  assignee   User?   @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  lastMessageAt DateTime  @default(now())
  resolvedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages SupportMessage[]

  @@unique([tenantId, number])
  @@index([tenantId, status, lastMessageAt])
  @@index([assigneeId, status])
  @@map("support_tickets")
}

model SupportMessage {
  id       String        @id @default(uuid())
  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId String
  author   User          @relation(fields: [authorId], references: [id], onDelete: Cascade)

  fromStaff      Boolean  @default(false)
  body           String
  attachmentUrls String[]

  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
  @@map("support_messages")
}

// ============================================================================
// AUDIT
// ============================================================================

// Append-only. Never updated, never deleted: this is what settles a dispute
// about who cancelled an order or changed a tariff.
model AuditLog {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  actorId   String?
  actor     User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorRole String?

  // entity.action, e.g. order.cancel, tariff.update.
  action   String
  entity   String
  entityId String?
  // Only the fields that changed, secrets already stripped.
  before   Json?
  after    Json?

  ip        String?
  userAgent String?
  requestId String?

  createdAt DateTime @default(now())

  @@index([tenantId, entity, entityId])
  @@index([tenantId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}
