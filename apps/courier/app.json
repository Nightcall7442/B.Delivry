{
  "expo": {
    "name": "Bazar Courier",
    "slug": "bazar-courier",
    "version": "0.0.1",
    "orientation": "portrait",
    "scheme": "bazar-courier",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "uz.bazardelivery.courier"
    },
    "android": {
      "package": "uz.bazardelivery.courier"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Bazar Courier показывает ваш путь клиенту, пока вы везёте заказ."
        }
      ],
      "expo-notifications",
      "expo-font",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Bazar Courier фотографирует весы у продавца, чтобы клиент видел точный вес."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
