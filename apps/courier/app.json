{
  "expo": {
    "name": "Bazar Courier",
    "slug": "bazar-courier",
    "version": "0.0.1",
    "orientation": "portrait",
    "scheme": "bazar-courier",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "uz.bazardelivery.courier"
    },
    "android": {
      "package": "uz.bazardelivery.courier",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Bazar Courier показывает ваш путь клиенту, пока вы везёте заказ."
        }
      ],
      "expo-notifications",
      "expo-font",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Bazar Courier фотографирует весы у продавца, чтобы клиент видел точный вес.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "22412d5a-f003-47c1-ad93-88b8c6363387"
      }
    },
    "owner": "yaqubov1405"
  }
}
